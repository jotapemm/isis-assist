// Isis-Assist — modelo de dados.
// Convenções (docs/PLANO.md §2): dinheiro em centavos (Int), datas de calendário em @db.Date,
// toda tabela de domínio carrega organizationId (a conta do proprietário).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Acesso (tabelas do Better Auth — nomes em inglês por serem da biblioteca) ───

model User {
  id                    String            @id
  name                  String
  email                 String            @unique
  emailVerified         Boolean           @default(false)
  image                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @default(now()) @updatedAt
  /// Versão dos Termos de Uso e da Política de Privacidade que a pessoa aceitou (src/modulos/legal/versao.ts).
  termosVersao          String?
  termosAceitosEm       DateTime?
  sessions              Session[]
  accounts              Account[]
  members               Member[]
  invitations           Invitation[]
  mudancasStatus        HistoricoStatus[]
  reajustes             Reajuste[]
  pagamentosRegistrados Pagamento[]

  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// Limite de tentativas do Better Auth (login, senha). No banco porque na Vercel cada instância
/// teria a sua memória — e o limite valeria por instância, não por pessoa.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// A conta do proprietário — o "tenant". Tudo do domínio pendura aqui.
model Organization {
  id            String         @id
  name          String
  slug          String         @unique
  logo          String?
  createdAt     DateTime
  metadata      String?
  members       Member[]
  invitations   Invitation[]
  configuracao  Configuracao?
  propriedades  Propriedade[]
  apartamentos  Apartamento[]
  inquilinos    Inquilino[]
  contratos     Contrato[]
  cobrancas     Cobranca[]
  despesas      Despesa[]
  prestadores   Prestador[]
  ordensServico OrdemServico[]
  lembretes     Lembrete[]
  arquivos      Arquivo[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─── Conta ───

/// Preferências da conta: dados do locador que saem no recibo e regras de cobrança.
model Configuracao {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locadorNome           String?
  locadorDocumento      String? // CPF ou CNPJ, só dígitos
  locadorTelefone       String? // só dígitos, com DDD
  locadorEmail          String?
  chavePix              String?
  multaPercentual       Decimal      @default(10) @db.Decimal(5, 2)
  jurosMensalPercentual Decimal      @default(1) @db.Decimal(5, 2)
  diasCarencia          Int          @default(0)
  proximoNumeroRecibo   Int          @default(1)
  /// Numeração das ordens de serviço, por conta ("OS nº 0007").
  proximoNumeroOS       Int          @default(1)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("configuracao")
}

// ─── Imóveis ───

/// Prédio de apartamentos ou residencial de casas: muda as palavras do app e o desenho do mapa.
enum TipoPropriedade {
  EDIFICIO
  CASAS
}

model Propriedade {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nome           String
  tipo           TipoPropriedade @default(EDIFICIO)
  cep            String? // só dígitos
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  uf             String?         @db.Char(2)
  observacoes    String?
  arquivadoEm    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  apartamentos   Apartamento[]

  @@index([organizationId])
  @@map("propriedade")
}

enum StatusApartamento {
  LIVRE
  OCUPADO
  RESERVADO
  REFORMA
  MANUTENCAO
}

/// De onde veio uma mudança de status — a usuária, um contrato, uma ordem de serviço ou um lembrete.
enum OrigemStatus {
  MANUAL
  CONTRATO
  MANUTENCAO
  LEMBRETE
  IMPORTACAO
}

model Apartamento {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  propriedadeId   String
  propriedade     Propriedade       @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  /// O "número" do apartamento como aparece na porta: "203", "01", "Casa 2".
  identificacao   String
  /// 0 = térreo; vazio = não se aplica (ex.: casas).
  andar           Int?
  bloco           String?
  descricao       String?
  quartos         Int?
  areaM2          Int?
  valorReferencia Int? // centavos
  status          StatusApartamento @default(LIVRE)
  observacoes     String?
  arquivadoEm     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  historicoStatus HistoricoStatus[]
  arquivos        Arquivo[]
  contratos       Contrato[]
  despesas        Despesa[]
  ordensServico   OrdemServico[]
  lembretes       Lembrete[]

  @@unique([propriedadeId, identificacao])
  @@index([organizationId])
  @@map("apartamento")
}

model HistoricoStatus {
  id             String             @id @default(cuid())
  organizationId String
  apartamentoId  String
  apartamento    Apartamento        @relation(fields: [apartamentoId], references: [id], onDelete: Cascade)
  /// Vazio no primeiro registro (cadastro do apartamento).
  de             StatusApartamento?
  para           StatusApartamento
  motivo         String?
  origem         OrigemStatus       @default(MANUAL)
  usuarioId      String?
  usuario        User?              @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())

  @@index([apartamentoId, createdAt])
  @@index([organizationId])
  @@map("historico_status")
}

// ─── Pessoas ───

model Inquilino {
  id                          String       @id @default(cuid())
  organizationId              String
  organization                Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nome                        String
  cpf                         String? // só dígitos
  rg                          String?
  dataNascimento              DateTime?    @db.Date
  telefone                    String? // só dígitos, com DDD
  email                       String?
  profissao                   String?
  rendaMensal                 Int? // centavos
  contatoEmergenciaNome       String?
  contatoEmergenciaTelefone   String?
  contatoEmergenciaParentesco String?
  observacoes                 String?
  /// Consentimento para receber mensagens pelo WhatsApp (LGPD). Começa desmarcado: só vale se o inquilino disse sim.
  aceitaWhatsapp              Boolean      @default(false)
  /// v2 — portal do inquilino: o login dele, quando for convidado.
  usuarioId                   String?      @unique
  /// v2 — cliente correspondente no gateway de pagamento (Asaas/Efí).
  gatewayClienteId            String?
  arquivadoEm                 DateTime?
  /// LGPD: dados pessoais apagados a pedido. Nome e CPF ficam até `guardarNomeAte` (recibos e imposto
  /// de renda); depois a rotina diária apaga também (src/modulos/inquilinos/privacidade.ts).
  dadosApagadosEm             DateTime?
  guardarNomeAte              DateTime?    @db.Date
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt
  fiadores                    Fiador[]
  arquivos                    Arquivo[]
  contratos                   Contrato[]

  @@unique([organizationId, cpf])
  @@index([organizationId])
  @@map("inquilino")
}

model Fiador {
  id             String     @id @default(cuid())
  organizationId String
  inquilinoId    String
  inquilino      Inquilino  @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  nome           String
  cpf            String?
  telefone       String?
  email          String?
  endereco       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  contratos      Contrato[]

  @@index([inquilinoId])
  @@map("fiador")
}

// ─── Arquivos ───

enum CategoriaArquivo {
  FOTO_APTO
  DOCUMENTO
  CONTRATO_PDF
  COMPROVANTE
  FOTO_OS
}

/// Metadados de um arquivo guardado no storage. O conteúdo fica fora do banco (disco em dev, S3 em produção).
model Arquivo {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chave          String           @unique
  nomeOriginal   String
  tipoMime       String
  tamanhoBytes   Int
  categoria      CategoriaArquivo
  ordem          Int              @default(0)
  apartamentoId  String?
  apartamento    Apartamento?     @relation(fields: [apartamentoId], references: [id], onDelete: Cascade)
  inquilinoId    String?
  inquilino      Inquilino?       @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  contratoId     String?
  contrato       Contrato?        @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pagamentoId    String?
  pagamento      Pagamento?       @relation(fields: [pagamentoId], references: [id], onDelete: Cascade)
  despesaId      String?
  despesa        Despesa?         @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  ordemServicoId String?
  ordemServico   OrdemServico?    @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  enviadoPorId   String?
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([apartamentoId])
  @@index([inquilinoId])
  @@index([contratoId])
  @@index([pagamentoId])
  @@index([despesaId])
  @@index([ordemServicoId])
  @@map("arquivo")
}

// ─── Contratos ───

enum StatusContrato {
  ATIVO
  ENCERRADO
}

/// Índice do reajuste anual. FIXO usa `percentualFixo`; NENHUM não reajusta.
enum IndiceReajuste {
  IGPM
  IPCA
  FIXO
  NENHUM
}

/// Liga um inquilino a um apartamento. Um apto só tem um contrato ATIVO por vez — garantido na ação de
/// criar, com a linha do apto travada (SELECT … FOR UPDATE) durante a transação.
/// Contrato é registro financeiro: nunca é apagado (NoAction impede apagar apto/inquilino que tenha contrato).
model Contrato {
  id                    String         @id @default(cuid())
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apartamentoId         String
  apartamento           Apartamento    @relation(fields: [apartamentoId], references: [id], onDelete: NoAction)
  inquilinoId           String
  inquilino             Inquilino      @relation(fields: [inquilinoId], references: [id], onDelete: NoAction)
  fiadorId              String?
  fiador                Fiador?        @relation(fields: [fiadorId], references: [id], onDelete: SetNull)
  dataInicio            DateTime       @db.Date
  dataFim               DateTime       @db.Date
  /// Aluguel em vigor (muda a cada reajuste), em centavos.
  valorAluguel          Int
  /// Aluguel na assinatura, em centavos.
  valorInicial          Int
  /// 1 a 31; em meses mais curtos vence no último dia.
  diaVencimento         Int
  valorCaucao           Int?
  caucaoDevolvidaEm     DateTime?      @db.Date
  valorCaucaoDevolvido  Int?
  indiceReajuste        IndiceReajuste @default(IGPM)
  percentualFixo        Decimal?       @db.Decimal(6, 3)
  /// Aniversário em que o próximo reajuste vence (vazio se NENHUM ou encerrado).
  proximoReajusteEm     DateTime?      @db.Date
  /// Vazios = usa as regras da conta (Configuracao).
  multaPercentual       Decimal?       @db.Decimal(5, 2)
  jurosMensalPercentual Decimal?       @db.Decimal(5, 2)
  status                StatusContrato @default(ATIVO)
  encerradoEm           DateTime?      @db.Date
  motivoEncerramento    String?
  observacoes           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  reajustes             Reajuste[]
  arquivos              Arquivo[]
  cobrancas             Cobranca[]

  @@index([organizationId, status])
  @@index([apartamentoId])
  @@index([inquilinoId])
  @@map("contrato")
}

model Reajuste {
  id             String         @id @default(cuid())
  organizationId String
  contratoId     String
  contrato       Contrato       @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  /// Aniversário do contrato a que este reajuste se refere.
  dataBase       DateTime       @db.Date
  indice         IndiceReajuste
  /// Variação acumulada usada (ex.: 4.2731 = 4,2731%). 0 quando a usuária manteve o valor.
  percentual     Decimal        @db.Decimal(8, 4)
  valorAnterior  Int
  valorNovo      Int
  observacao     String?
  aplicadoPorId  String?
  aplicadoPor    User?          @relation(fields: [aplicadoPorId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([contratoId, dataBase])
  @@map("reajuste")
}

/// Variação mensal oficial (Banco Central, SGS: IGP-M = série 189, IPCA = 433). Global, sem conta:
/// é o mesmo número para todo mundo. Só guarda o que veio da fonte — nunca valor inventado.
model IndiceEconomico {
  id          String         @id @default(cuid())
  indice      IndiceReajuste
  /// Primeiro dia do mês de referência.
  competencia DateTime       @db.Date
  variacao    Decimal        @db.Decimal(8, 4)
  createdAt   DateTime       @default(now())

  @@unique([indice, competencia])
  @@map("indice_economico")
}

// ─── Financeiro ───

/**
 * "Atrasada" não é gravado: é calculado (vencimento + tolerância < hoje e não quitada).
 */
enum StatusCobranca {
  PENDENTE
  PARCIAL
  PAGO
  CANCELADO
}

enum FormaPagamento {
  PIX
  DINHEIRO
  TRANSFERENCIA
  BOLETO
  CARTAO
  OUTRA
}

/**
 * v2: pagamento que chega sozinho pelo gateway (PIX/boleto) em vez de ser registrado à mão.
 */
enum OrigemPagamento {
  MANUAL
  GATEWAY
}

/**
 * Aluguel de um mês de um contrato.
 */
model Cobranca {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contratoId        String
  contrato          Contrato       @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  /// Primeiro dia do mês de referência.
  competencia       DateTime       @db.Date
  vencimento        DateTime       @db.Date
  valor             Int // centavos
  descricao         String?
  status            StatusCobranca @default(PENDENTE)
  /// "contrato:AAAA-MM" — gerar o mês duas vezes nunca duplica.
  chaveGeracao      String?        @unique
  /// v2 — cobrança no gateway (Asaas/Efí): id, PIX copia-e-cola e link de pagamento.
  gatewayProvedor   String?
  gatewayCobrancaId String?
  pixCopiaECola     String?
  linkPagamento     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  pagamentos        Pagamento[]

  @@index([organizationId, competencia])
  @@index([organizationId, status, vencimento])
  @@index([contratoId])
  @@map("cobranca")
}

model Pagamento {
  id              String          @id @default(cuid())
  organizationId  String
  cobrancaId      String
  cobranca        Cobranca        @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
  data            DateTime        @db.Date
  /// Tudo que entrou: principal + multa + juros.
  valorPago       Int
  /// Parte que abate o aluguel.
  valorPrincipal  Int
  multa           Int             @default(0)
  juros           Int             @default(0)
  forma           FormaPagamento
  observacao      String?
  /// Número sequencial do recibo, por conta.
  numeroRecibo    Int
  origem          OrigemPagamento @default(MANUAL)
  registradoPorId String?
  registradoPor   User?           @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)
  /// Pagamento lançado por engano e desfeito: continua guardado, mas não conta.
  estornadoEm     DateTime?
  createdAt       DateTime        @default(now())
  arquivos        Arquivo[]

  @@unique([organizationId, numeroRecibo])
  @@index([cobrancaId])
  @@index([organizationId, data])
  @@map("pagamento")
}

enum CategoriaDespesa {
  IPTU
  CONDOMINIO
  AGUA
  LUZ
  GAS
  INTERNET
  MANUTENCAO
  SEGURO
  TAXAS
  OUTROS
}

model Despesa {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Vazio = despesa geral do residencial (luz da área comum, IPTU do prédio…).
  apartamentoId  String?
  apartamento    Apartamento?     @relation(fields: [apartamentoId], references: [id], onDelete: SetNull)
  categoria      CategoriaDespesa
  descricao      String
  valor          Int // centavos
  data           DateTime         @db.Date
  observacao     String?
  /// Fase 4: despesa criada sozinha ao concluir uma ordem de serviço.
  ordemServicoId String?          @unique
  ordemServico   OrdemServico?    @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)
  removidaEm     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  arquivos       Arquivo[]

  @@index([organizationId, data])
  @@map("despesa")
}

// ─── Manutenções (Fase 4) ───

/// Quem faz os consertos: encanador, eletricista, pintor…
model Prestador {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  nome           String
  especialidade  String?
  telefone       String? // só dígitos, com DDD
  email          String?
  documento      String? // CPF ou CNPJ, só dígitos
  chavePix       String?
  observacoes    String?
  arquivadoEm    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  ordens         OrdemServico[]

  @@index([organizationId])
  @@map("prestador")
}

enum PrioridadeOS {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum StatusOS {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

/// Ordem de serviço: um conserto num imóvel (ou na área comum), do pedido até o custo final.
model OrdemServico {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  numero             Int
  /// Vazio = área comum do residencial.
  apartamentoId      String?
  apartamento        Apartamento?       @relation(fields: [apartamentoId], references: [id], onDelete: SetNull)
  prestadorId        String?
  prestador          Prestador?         @relation(fields: [prestadorId], references: [id], onDelete: SetNull)
  titulo             String
  descricao          String?
  prioridade         PrioridadeOS       @default(MEDIA)
  status             StatusOS           @default(ABERTA)
  custoEstimado      Int? // centavos
  custoFinal         Int? // centavos
  abertaEm           DateTime           @db.Date
  concluidaEm        DateTime?          @db.Date
  /// O que foi feito (na conclusão) ou por que foi cancelada.
  solucao            String?
  /// Status do imóvel antes de a OS colocá-lo em Manutenção — para voltar a ele no fim.
  statusAnteriorApto StatusApartamento?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  despesa            Despesa?
  arquivos           Arquivo[]

  @@unique([organizationId, numero])
  @@index([organizationId, status])
  @@index([apartamentoId])
  @@map("ordem_servico")
}

// ─── Lembretes (Fase 5) ───

enum RecorrenciaLembrete {
  NENHUMA
  SEMANAL
  MENSAL
  ANUAL
}

/// Lembrete com data, ou anotação (sem data). Os do sistema (reajuste, fim de contrato, aluguel vencendo)
/// não ficam aqui: são calculados na hora (src/modulos/lembretes/consultas.ts).
model Lembrete {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Vazio = do residencial todo.
  apartamentoId  String?
  apartamento    Apartamento?        @relation(fields: [apartamentoId], references: [id], onDelete: SetNull)
  titulo         String
  descricao      String?
  /// Vazio = anotação.
  data           DateTime?           @db.Date
  /// "HH:MM", opcional.
  hora           String?
  importante     Boolean             @default(false)
  recorrencia    RecorrenciaLembrete @default(NENHUMA)
  /// Dia do mês pedido na recorrência mensal/anual: o "todo dia 31" volta ao 31 depois de fevereiro.
  diaRecorrencia Int?
  concluidoEm    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, concluidoEm, data])
  @@index([apartamentoId])
  @@map("lembrete")
}
