# Copie para .env e ajuste.

# Banco. Em desenvolvimento, "npm run db:subir" sobe um Postgres local do Prisma nestas portas.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Login (Better Auth). Gere um segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Arquivos enviados (fotos, documentos). Em dev ficam em disco ("local"); no deploy, "s3" com o
# Supabase Storage (ou R2/MinIO). Passo a passo em docs/DEPLOY.md.
ARMAZENAMENTO_DRIVER="local"
# ARMAZENAMENTO_DIR=".armazenamento"
# ARMAZENAMENTO_S3_ENDPOINT="https://<ref>.storage.supabase.co/storage/v1/s3"
# ARMAZENAMENTO_S3_REGIAO="sa-east-1"
# ARMAZENAMENTO_S3_BUCKET="arquivos"
# ARMAZENAMENTO_S3_CHAVE=""
# ARMAZENAMENTO_S3_SEGREDO=""

# E-mail (produção). Sem a chave, os e-mails de "esqueci a senha" aparecem no terminal.
RESEND_API_KEY=""
EMAIL_REMETENTE="Isis-Assist <nao-responda@seu-dominio.com.br>"

# Conta de demonstração criada pelo seed (npm run db:seed)
SEED_EMAIL="demo@isis-assist.app"
SEED_SENHA="isis-demo-2026"

# Rotina diária (/api/cron/diario): gera as cobranças do mês e atualiza os índices. Gere um valor aleatório.
CRON_SECRET=""
